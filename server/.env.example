PORT=3000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Firebase Admin (server-side)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Zoom OAuth
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=http://localhost:3000/api/zoom/oauth/callback
ZOOM_WEBHOOK_SECRET_TOKEN=

# Zoom SDK (required for RTMS real-time transcription)
ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=
ZOOM_VERIFY_TOKEN=

# Resend (email sending)
RESEND_API_KEY=
EMAIL_FROM=DealForge <noreply@dealforge.app>

# Gmail OAuth (send via connected Gmail account)
# OAuth redirect URIs: https://<server>/api/email/oauth/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outlook OAuth (send via connected Microsoft 365 account)
# OAuth redirect URIs: https://<server>/api/email/oauth/outlook/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Base URL for OAuth callbacks (defaults to CLIENT_URL/api/email/oauth)
OAUTH_REDIRECT_BASE=

# Security
SESSION_SECRET=

# Redis (optional - for buffer and tracking persistence)
REDIS_URL=

# Sentry (optional - error tracking)
SENTRY_DSN=

# Dodo Payments
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PRO_PRODUCT_ID=
DODO_ENTERPRISE_PRODUCT_ID=
