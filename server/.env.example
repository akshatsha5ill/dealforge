# Server Environment Variables
# Copy this file to .env and fill in the values

# Server
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Firebase Admin (server-side)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Zoom OAuth
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=http://localhost:3000/api/zoom/oauth/callback
ZOOM_WEBHOOK_SECRET_TOKEN=

# Zoom SDK (required for RTMS real-time transcription)
ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=
ZOOM_VERIFY_TOKEN=

# Resend (email sending)
RESEND_API_KEY=
EMAIL_FROM=DealForge <noreply@dealforge.app>

# Security
SESSION_SECRET=

# Redis (optional, for buffer and tracking persistence)
REDIS_URL=

# Sentry (optional, error tracking)
SENTRY_DSN=

# Dodo Payments
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PRO_PRODUCT_ID=
DODO_ENTERPRISE_PRODUCT_ID=

# AI API Keys (optional, for transcript analysis pipeline)
# At least one is needed for real-time in-meeting AI suggestions
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
