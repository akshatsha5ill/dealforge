# Client Environment Variables
# Copy this file to .env and fill in the values

# Firebase configuration (required for authentication)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# API URL (required for production — set to your server URL)
# In development, the Vite proxy handles this automatically
# Examples:
#   Production: https://dealforge-server.onrender.com
#   Staging: https://dealforge-staging.onrender.com
VITE_API_URL=

# Google Analytics measurement ID (optional — analytics only loads with user consent)
VITE_GA_ID=

# Sentry DSN (optional, error tracking)
VITE_SENTRY_DSN=
